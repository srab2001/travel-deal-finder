# Copy to .env and fill in your values. .env is gitignored.

# Flight pricing provider. Currently supported: kiwi
FLIGHT_PROVIDER=kiwi

# Kiwi.com (Tequila) API key
#   1. Sign up at https://tequila.kiwi.com
#   2. Create a "Solution" and copy the apikey from your Solutions page
#   3. Paste below
# Leave blank to use deterministic mock data (fine for local testing).
FLIGHT_API_KEY=
